# PromptGuard self-hosted stack — copy to .env and fill in.
# (This is for docker-compose at the repo root. The dashboard/.env.example
#  is only for running the dashboard bare/locally without Docker.)

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=promptguard
POSTGRES_DB=promptguard
# REQUIRED. Strong random password for the database.
POSTGRES_PASSWORD=

# --- App ------------------------------------------------------------------
# REQUIRED. 32+ char cryptographically random string. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# Proxmox / LAN over plain HTTP -> false (a Secure cookie is rejected by
# browsers over http:// and login would never persist).
# Behind HTTPS (Hetzner + Caddy) -> true.
SESSION_COOKIE_SECURE=false

# The URL users reach the dashboard on. Used to prefill the IT-rollout
# templates and extension setup. Baked at build time — rebuild after changing.
#   Proxmox LAN:  http://192.168.1.50         (your server's LAN IP[:port])
#   Hetzner:      https://promptguard.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional extra CORS origins for /api/ingest (comma-separated). Browser
# extension origins are always allowed; usually leave this empty.
ALLOWED_ORIGINS=

# --- Caddy / networking ---------------------------------------------------
# :80                       -> serve plain HTTP on the LAN (Proxmox now)
# promptguard.example.com   -> Caddy auto-provisions HTTPS (Hetzner later)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
